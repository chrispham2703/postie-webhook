POSTGRES_DB=postie_test
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

RABBITMQ_USER=your_username
RABBITMQ_PASSWORD=your_password

PORT=3000
NODE_ENV=test
DATABASE_URL=postgresql://your_username:your_password@localhost:5432/postie_test
RABBITMQ_URL=amqp://your_username:your_password@localhost:5672
JWT_SECRET=your_jwt_secret
RESEND_API_KEY=your_resend_api_key

# A separate database from dev (postie_test, not postie) so running the test
# suite never touches your real dev data. Create it once:
#   docker exec <postgres-container> psql -U <user> -d <db> -c "CREATE DATABASE postie_test;"
# Then apply migrations + seed against it:
#   set -a && source .env.test && set +a && npx prisma migrate deploy && node prisma/seed.js
